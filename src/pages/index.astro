---
/**
 * Home.
 * Yodezeen: hero IS the media — full-bleed video, text floats on it.
 * Bureau: full-bleed editorial project showcase, asymmetric splits.
 * Sawdust: clean shop teaser.
 *
 * All media slots are swap-safe: drop the named file into
 * /public/assets/ and it replaces the Unsplash demo automatically.
 */
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Placeholder from '../components/Placeholder.astro';
import { projects as allProjects } from '../data/projects';
import { products as allProducts } from '../data/products';

const projects = allProjects.slice(0, 3);

const homeProjectImages = [
  '/assets/home/selected-project-01.jpg',
  '/assets/home/selected-project-02.jpg',
  '/assets/home/selected-project-03.jpg',
];

const pieces = allProducts.slice(0, 4);

const lookbook = [
  {
    label: '01 / Luxury Lounge Chair',
    image: '/assets/home/furniture-lookbook-01.jpg',
    alt: 'Luxury Lounge Chair in a curated living space',
  },
  {
    label: '02 / Coastal Lounge Setting',
    image: '/assets/home/furniture-lookbook-02.jpg',
    alt: 'Coastal lounge setting',
  },
  {
    label: '03 / Dining Table Study',
    image: '/assets/home/furniture-lookbook-03.jpg',
    alt: 'Dining table study by KAMU',
  },
];
---

<Base title="Interior Design Studio, Bali">
  <Preloader />

  <!-- ============ HERO — full-bleed video, text floats on it ============ -->
  <section class="hero" data-nav-invert>
    <div class="hero-media">
      {/* poster shows the home asset now; add src="/assets/hero-video.mp4" when the film lands */}
      <video
        poster="/assets/home/cover-page.jpg"
        data-swap="hero-video.mp4"
        autoplay
        muted
        loop
        playsinline
      ></video>
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-text">
      <p class="hero-eyebrow label hero-el">
        <span class="duo"><span>Interior Design Studio</span><span class="duo-sub">Bali</span></span>
      </p>
      <h1 class="display hero-headline">
        <span class="hero-line"><span class="hero-el">We design houses</span></span>
        <span class="hero-line"><span class="hero-el">we want to live in</span></span>
      </h1>
    </div>

    <p class="hero-quote quote hero-el">
      &ldquo;Your home should feel like an exhale.&rdquo;
    </p>
  </section>

  <!-- ============ MANIFESTO — asymmetric editorial statement ============ -->
  <section class="manifesto">
    <div class="grid-12">
      <p class="label manifesto-label" data-reveal>The Studio</p>
      <h2 class="h1 manifesto-statement" data-reveal="line">
        Thoughtful interiors rooted in craftsmanship, natural materials, and intentional living.
      </h2>
      <div class="manifesto-body" data-reveal data-reveal-delay="0.15">
        <p>
          From concept to completion, we create spaces that are personal,
          timeless, and designed around the people who live in them.
          Every material, texture, and detail is carefully considered to
          bring warmth, balance, and lasting character.
        </p>
        <a href="/about/" class="text-link label">About the studio</a>
      </div>
    </div>
  </section>

  <section class="studio-panel" aria-labelledby="studio-panel-title">
    <figure class="studio-panel-media" data-reveal="media">
      <img src="/assets/home/ceo-picture-fill.jpg" alt="KAMU Concepts founder portrait" loading="lazy" />
      <figcaption>KAMU Concepts Studio</figcaption>
    </figure>

    <div class="studio-panel-copy" data-reveal>
      <p class="label studio-panel-eyebrow">About Us</p>
      <h2 id="studio-panel-title" class="studio-panel-title">KAMU Concepts</h2>
      <p class="label studio-panel-subtitle">Studio and Design</p>
      <span class="studio-panel-rule" aria-hidden="true"></span>
      <p class="studio-panel-text">
        We believe great interiors begin with understanding people before
        spaces. Every project starts by listening — how you live, gather,
        work, and unwind. From there, we shape timeless interiors through
        thoughtful planning, natural materials, and craftsmanship that
        endures beyond trends.
      </p>

      <div class="studio-panel-values" aria-label="KAMU Concepts values">
        <span><small>01</small>Craft</span>
        <span><small>02</small>Material</span>
        <span><small>03</small>Living</span>
      </div>

      <a href="/about/" class="studio-panel-link">
        <span>Read more about us</span>
        <span aria-hidden="true">+</span>
      </a>
    </div>
  </section>

  <!-- ============ SELECTED WORK — Bureau: full-bleed, asymmetric ============ -->
  <section class="work">
    <header class="work-head grid-12">
      <h2 class="display work-title" data-reveal="line">Selected<br />Project</h2>
      <p class="label work-count" data-reveal>
        <span class="duo"><span>Project</span><span class="duo-num">01</span></span>
      </p>
    </header>

    <!-- Feature: auto-advancing, editorial project showcase -->
    <div class="feature" data-parallax data-project-slider>
      {
        projects.map((project, i) => (
          <a
            href={`/projects/${project.slug}/`}
            class={`feature-slide ${i === 0 ? 'is-active' : ''}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
            data-project-slide
          >
            <img src={homeProjectImages[i]} alt={project.name} loading={i === 0 ? 'eager' : 'lazy'} />
            <div class="feature-caption">
              <h3 class="h2">{project.name}</h3>
              <p class="label feature-meta duo">
                <span>{project.location}</span><span class="duo-sub">{project.type}</span>
              </p>
            </div>
          </a>
        ))
      }

      <button class="feature-arrow feature-prev" type="button" data-project-prev aria-label="Previous selected project">
        ‹
      </button>
      <button class="feature-arrow feature-next" type="button" data-project-next aria-label="Next selected project">
        ›
      </button>

      <div class="feature-dots" aria-label="Selected projects">
        {
          projects.map((_, i) => (
            <button
              class={`feature-dot ${i === 0 ? 'is-active' : ''}`}
              type="button"
              data-project-dot={i}
              aria-label={`Show selected project ${i + 1}`}
            />
          ))
        }
      </div>
    </div>

    <div class="work-all grid-12">
      <a href="/projects/" class="work-button label" data-reveal>See All Projects</a>
    </div>
  </section>

  <section class="lookbook" aria-labelledby="lookbook-title">
    <header class="lookbook-head">
      <h2 id="lookbook-title" class="lookbook-title" data-reveal="line">
        CURATED LIVING
      </h2>
      <p class="lookbook-intro" data-reveal data-reveal-delay="0.1">
        A collection of furniture and objects inspired by the spaces we
        create — crafted to bring warmth, balance, and character into
        everyday life.
      </p>
    </header>

    <div class="lookbook-stage" data-reveal="media">
      {
        lookbook.map((item, i) => (
          <figure class={`lookbook-slide ${i === 0 ? 'is-active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>
            <img src={item.image} alt={item.alt} loading={i === 0 ? 'eager' : 'lazy'} />
            <figcaption class="lookbook-label">{item.label}</figcaption>
          </figure>
        ))
      }

      <button class="lookbook-arrow lookbook-prev" type="button" data-lookbook-prev aria-label="Previous lookbook slide">
        ‹
      </button>
      <button class="lookbook-arrow lookbook-next" type="button" data-lookbook-next aria-label="Next lookbook slide">
        ›
      </button>

      <div class="lookbook-dots" aria-label="Lookbook slides">
        {
          lookbook.map((_, i) => (
            <button
              class={`lookbook-dot ${i === 0 ? 'is-active' : ''}`}
              type="button"
              data-lookbook-dot={i}
              aria-label={`Show lookbook slide ${i + 1}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PHILOSOPHY — mist band ============ -->
  <section class="philosophy">
    <div class="grid-12">
      <p class="philosophy-quote" data-reveal="line">
        Atmosphere over decoration. Handmade elements, natural textures, and
        warm neutral tones — spaces that feel calm, lived-in and effortlessly
        inviting.
      </p>
      <p class="label philosophy-credit" data-reveal data-reveal-delay="0.2">
        Slow Tropical Living
      </p>
    </div>
  </section>

  <!-- ============ COLLECTION — Sawdust: clean e-comm row ============ -->
  <section class="collection">
    <header class="collection-head">
      <p class="label collection-eyebrow" data-reveal>
        <span class="duo"><span>by KAMU</span><span class="duo-sub">Explore Our Pieces</span></span>
      </p>
      <h2 class="collection-title" data-reveal="line">
        THE COLLECTION<br /><em>for Timeless Living</em>
      </h2>
    </header>

    <div class="collection-row" id="collection-row">
      {
        pieces.map((p, i) => (
          <a
            href={`/shop/${p.slug}/`}
            class="collection-card"
            data-reveal
            data-reveal-delay={String(i * 0.08)}
            draggable="false"
          >
            <Placeholder name={p.file} ratio="1x1" demo={p.demo} alt={p.name} />
            <div class="collection-caption">
              <h3 class="collection-name">{p.name}</h3>
            </div>
          </a>
        ))
      }
    </div>

    <div class="collection-foot" data-reveal>
      <a href="/shop/" class="btn btn--secondary collection-cta">Shop Now</a>
    </div>
  </section>
</Base>

<style>
  /* (grid-12 + text-link live in global.css) */

  .philosophy {
    display: none;
  }

  /* ================= HERO ================= */
  .hero {
    position: relative;
    height: 100svh;
    width: 100%;
    overflow: hidden;
    color: var(--c-bone);
  }

  .hero-media,
  .hero-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media video {
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--c-black) 62%, transparent) 0%,
        transparent 45%
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--c-black) 30%, transparent) 0%,
        transparent 22%
      );
  }

  /* Headline bottom-left (brand placement grid) */
  .hero-text {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    bottom: clamp(2.5rem, 7vh, 5rem);
    max-width: 80%;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-s);
    color: var(--c-bone);
    font-size: clamp(1rem, 1vw, 1.125rem);
    font-weight: 700;
    text-shadow: 0 1px 18px rgb(0 0 0 / 0.42);
  }

  .hero-headline {
    text-transform: uppercase;
  }

  .hero-line {
    display: block;
    overflow: hidden;
  }

  .hero-line > span {
    display: block;
  }

  /* Quote floats bottom-right — asymmetric counterweight */
  .hero-quote {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: clamp(2.5rem, 7vh, 5rem);
    max-width: 17rem;
    text-align: right;
    font-size: 1rem;
    color: color-mix(in srgb, var(--c-bone) 85%, transparent);
  }

  /* Hero intro: hidden until preloader hands off (JS sets visible) */
  @media (prefers-reduced-motion: no-preference) {
    html:not(.no-js) .hero-el {
      opacity: 0;
    }
  }

  @media (max-width: 56rem) {
    .hero-quote {
      display: none;
    }

    .hero-text {
      left: var(--gutter);
      right: var(--gutter);
      bottom: max(2rem, env(safe-area-inset-bottom));
      max-width: none;
    }

    .hero-eyebrow {
      margin-bottom: 1.25rem;
      font-size: clamp(0.75rem, 3vw, 0.95rem);
    }

    .hero-eyebrow .duo {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      white-space: normal;
    }

    .hero-headline {
      max-width: 10ch;
      font-size: clamp(2.55rem, 11vw, 4rem);
      line-height: 0.98;
      overflow-wrap: anywhere;
    }
  }

  /* ================= MANIFESTO ================= */
  .manifesto {
    padding-block: var(--space-2xl);
  }

  .manifesto-label {
    grid-column: 1 / 3;
    color: var(--ink);
    padding-top: 0.75rem;
  }

  .manifesto-statement {
    grid-column: 4 / 13;
    text-wrap: balance;
  }

  .manifesto-body {
    grid-column: 7 / 12;
    margin-top: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    color: var(--ink-soft);
  }

  /* Pull-quote: Lora italic, high-contrast ink (#202020) — never the
     terracotta accent, which is accent-only and not for body copy. */
  .manifesto-body p {
    color: var(--ink);
    font-style: italic;
    font-size: var(--fs-sub);
    line-height: var(--lh-body);
  }

  @media (max-width: 56rem) {
    .manifesto-label {
      grid-column: 1 / -1;
      margin-bottom: var(--space-s);
    }

    .manifesto-statement {
      grid-column: 1 / -1;
    }

    .manifesto-body {
      grid-column: 2 / -1;
    }
  }

  /* ================= STUDIO PANEL ================= */
  .studio-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    min-height: 100svh;
    margin-bottom: var(--space-xl);
    background: var(--bg-alt);
  }

  .studio-panel-media {
    position: relative;
    min-height: 42rem;
    margin: 0;
    overflow: hidden;
  }

  .studio-panel-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .studio-panel-media figcaption {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-m);
    color: var(--c-bone);
    font-size: 0.72rem;
  }

  .studio-panel-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(4rem, 8vw, 8rem) var(--gutter);
  }

  .studio-panel-eyebrow,
  .studio-panel-subtitle {
    color: var(--ink-soft);
  }

  .studio-panel-title {
    margin-top: var(--space-s);
    color: var(--ink);
    font-size: clamp(2.25rem, 4vw, 4.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .studio-panel-subtitle {
    margin-top: var(--space-s);
  }

  .studio-panel-rule {
    width: 3.25rem;
    height: 1px;
    margin-top: var(--space-l);
    background: var(--accent-soft);
  }

  .studio-panel-text {
    max-width: 34rem;
    margin-top: var(--space-l);
    color: var(--ink);
    font-size: clamp(1.1rem, 1.45vw, 1.45rem);
    line-height: 1.45;
  }

  .studio-panel-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
    max-width: 34rem;
    margin-top: var(--space-l);
  }

  .studio-panel-values span {
    display: flex;
    min-height: 3.5rem;
    flex-direction: column;
    justify-content: end;
    gap: 0.55rem;
    border-right: 1px solid color-mix(in srgb, var(--ink-soft) 26%, transparent);
    color: var(--ink);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
  }

  .studio-panel-values span:last-child {
    border-right: 0;
  }

  .studio-panel-values small {
    color: var(--accent);
    font-size: 0.66rem;
  }

  .studio-panel-link {
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-l);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 650;
  }

  @media (max-width: 56rem) {
    .studio-panel {
      grid-template-columns: 1fr;
    }

    .studio-panel-media {
      min-height: 65vh;
    }

    .studio-panel-copy {
      padding-block: var(--space-xl);
    }

    .studio-panel-values {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .studio-panel-values span {
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--ink-soft) 22%, transparent);
      padding-bottom: var(--space-xs);
    }
  }

  /* ================= WORK ================= */
  .work-head {
    align-items: end;
    margin-bottom: var(--space-l);
  }

  .work-title {
    grid-column: 1 / 9;
    text-transform: uppercase;
  }

  .work-count {
    grid-column: 11 / 13;
    justify-self: end;
    color: var(--ink-soft);
    padding-bottom: 1rem;
  }

  /* Feature — true full bleed, tall */
  .feature {
    position: relative;
    width: 100%;
    height: min(100svh, 60rem);
    overflow: hidden;
  }

  .feature-slide {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .feature-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .feature-slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-caption {
    position: absolute;
    left: var(--gutter);
    bottom: var(--space-m);
    z-index: 2;
    color: var(--c-bone);
  }

  .feature-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--c-black) 55%, transparent) 0%,
      transparent 38%
    );
  }

  .feature-caption {
    z-index: 2;
  }

  .feature-meta {
    margin-top: 0.5rem;
    opacity: 0.8;
  }

  .feature-arrow,
  .feature-dot {
    position: absolute;
    z-index: 3;
    border: 1px solid color-mix(in srgb, var(--c-bone) 60%, transparent);
    background: color-mix(in srgb, var(--c-black) 18%, transparent);
    color: var(--c-bone);
  }

  .feature-arrow {
    top: 50%;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    font-size: 2rem;
    line-height: 1;
    transform: translateY(-50%);
    transition: background-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }

  .feature-arrow:hover {
    background: color-mix(in srgb, var(--c-bone) 22%, transparent);
  }

  .feature-prev { left: var(--gutter); }
  .feature-next { right: var(--gutter); }

  .feature-dots {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: var(--space-m);
    display: flex;
    gap: 0.45rem;
    transform: translateX(-50%);
  }

  .feature-dot {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border-radius: 50%;
    opacity: 0.65;
  }

  .feature-dot.is-active {
    background: var(--c-bone);
    opacity: 1;
  }

  .work-all {
    margin-top: var(--space-l);
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
    align-items: center;
  }

  .work-button {
    grid-column: 1 / -1;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    min-height: 2.8rem;
    padding-inline: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--ink) 24%, transparent);
    border-radius: 999px;
    color: var(--ink);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .work-button:hover {
    background: var(--ink);
    color: var(--c-bone);
    transform: translateY(-0.15rem);
  }

  @media (max-width: 56rem) {
    .work-title {
      grid-column: 1 / -1;
    }

    .work-count {
      grid-column: 1 / -1;
      justify-self: start;
      margin-top: var(--space-2xs);
    }

    .feature {
      height: 70svh;
    }

    .work-button {
      grid-column: 1 / -1;
    }
  }

  /* ================= PHILOSOPHY ================= */
  .philosophy {
    margin-top: var(--space-2xl);
    background: var(--natural);
    color: var(--c-bone);
    padding-block: var(--space-2xl);
  }

  /* Montserrat, bone on the mist-green band — clean, modern, well-weighted
     for strong contrast (not a faint serif overlay). */
  .philosophy-quote {
    grid-column: 2 / 11;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--c-bone);
    text-wrap: balance;
  }

  .philosophy-credit {
    grid-column: 2 / 8;
    margin-top: var(--space-l);
    color: color-mix(in srgb, var(--c-bone) 78%, transparent);
  }

  @media (max-width: 56rem) {
    .philosophy-quote,
    .philosophy-credit {
      grid-column: 1 / -1;
    }
  }

  /* ================= COLLECTION — Sawdust ================= */
  .collection {
    padding-block: var(--space-2xl) 0;
  }

  .collection-head {
    text-align: center;
    padding-inline: var(--gutter);
    margin-bottom: var(--space-xl);
  }

  .collection-eyebrow {
    color: var(--ink);
    margin-bottom: var(--space-s);
  }

  .collection-title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-snug);
    text-wrap: balance;
  }

  .collection-title em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  /* Product grid mirrors shop: 450px media, transparent, uncropped. */
  .collection-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-m);
    row-gap: var(--space-xl);
    padding-inline: var(--gutter);
  }


  .collection-card {
    min-width: 0;
    user-select: none;
  }

  .collection-card :global(.media),
  .collection-card :global(.ph) {
    width: min(450px, 100%);
    max-width: 100%;
    margin-inline: auto;
    background: transparent !important;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .collection-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    object-position: center;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .collection-caption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: 0.75rem;
  }

  .collection-name {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  .collection-foot {
    display: flex;
    justify-content: center;
    margin-top: var(--space-l);
  }

  @media (max-width: 80rem) {
    .collection-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 56rem) {
    .collection-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .collection-row {
      grid-template-columns: 1fr;
      row-gap: var(--space-l);
    }
  }

  /* ================= LOOKBOOK ================= */
  .lookbook {
    background: var(--c-bone);
    color: var(--ink);
    min-height: 100svh;
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .lookbook-head {
    padding-inline: var(--gutter);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    text-align: center;
  }

  .lookbook-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0.04em;
  }

  .lookbook-intro {
    max-width: 42rem;
    margin: 1.4rem auto 0;
    color: var(--ink-soft);
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.45;
  }

  .lookbook-stage {
    position: relative;
    height: clamp(22rem, 50svh, 38rem);
    overflow: hidden;
    background: var(--c-black);
  }

  .lookbook-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .lookbook-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .lookbook-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
  }

  .lookbook-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.38), transparent 42%),
      linear-gradient(0deg, rgb(0 0 0 / 0.25), transparent 34%);
    pointer-events: none;
  }

  .lookbook-label {
    position: absolute;
    z-index: 2;
    top: clamp(1.25rem, 2vw, 2rem);
    left: var(--gutter);
    color: var(--c-bone);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .lookbook-arrow {
    position: absolute;
    z-index: 3;
    top: 50%;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: var(--c-bone);
    background: rgb(255 255 255 / 0.16);
    transform: translateY(-50%);
    backdrop-filter: blur(10px);
    font-size: 1.8rem;
    line-height: 1;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .lookbook-arrow:hover {
    background: rgb(255 255 255 / 0.28);
  }

  .lookbook-prev {
    left: clamp(1rem, 2vw, 2rem);
  }

  .lookbook-next {
    right: clamp(1rem, 2vw, 2rem);
  }

  .lookbook-dots {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: clamp(1.1rem, 2vw, 1.8rem);
    display: flex;
    gap: 0.36rem;
    transform: translateX(-50%);
  }

  .lookbook-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.35);
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .lookbook-dot.is-active {
    background: var(--c-bone);
  }

  @media (max-width: 48rem) {
    .lookbook-head {
      margin-bottom: 2rem;
    }

    .lookbook-stage {
      height: clamp(20rem, 58svh, 30rem);
      min-height: 0;
    }
  }

</style>

<script>
  import { gsap } from 'gsap';

  // Hero intro — waits for the preloader curtain (kamu:ready)
  const intro = () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = document.querySelectorAll<HTMLElement>('.hero-el');

    if (reduced) {
      els.forEach((el) => (el.style.opacity = '1'));
      return;
    }

    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .fromTo(
        '.hero-line > .hero-el',
        { yPercent: 110, opacity: 1 },
        { yPercent: 0, duration: 1.4, stagger: 0.12 },
        0.1
      )
      .fromTo(
        '.hero-eyebrow',
        { y: 16, opacity: 0 },
        { y: 0, opacity: 1, duration: 1 },
        0.5
      )
      .fromTo(
        '.hero-quote',
        { y: 16, opacity: 0 },
        { y: 0, opacity: 1, duration: 1.2 },
        0.8
      );
  };

  if ((window as any).__kamuReady) {
    intro();
  } else {
    window.addEventListener('kamu:ready', intro, { once: true });
  }

  const lookbookSlides = [...document.querySelectorAll<HTMLElement>('.lookbook-slide')];
  const lookbookDots = [...document.querySelectorAll<HTMLButtonElement>('.lookbook-dot')];
  let lookbookIndex = 0;

  const setLookbook = (next: number) => {
    if (!lookbookSlides.length) return;
    lookbookIndex = (next + lookbookSlides.length) % lookbookSlides.length;

    lookbookSlides.forEach((slide, i) => {
      const active = i === lookbookIndex;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', active ? 'false' : 'true');
    });

    lookbookDots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === lookbookIndex);
    });
  };

  document
    .querySelector<HTMLButtonElement>('[data-lookbook-prev]')
    ?.addEventListener('click', () => setLookbook(lookbookIndex - 1));

  document
    .querySelector<HTMLButtonElement>('[data-lookbook-next]')
    ?.addEventListener('click', () => setLookbook(lookbookIndex + 1));

  lookbookDots.forEach((dot, i) => {
    dot.addEventListener('click', () => setLookbook(i));
  });

  const projectSlider = document.querySelector<HTMLElement>('[data-project-slider]');
  const projectSlides = [...document.querySelectorAll<HTMLElement>('[data-project-slide]')];
  const projectDots = [...document.querySelectorAll<HTMLButtonElement>('[data-project-dot]')];
  let projectIndex = 0;
  let projectTimer: number | undefined;

  const setProject = (next: number) => {
    if (!projectSlides.length) return;
    projectIndex = (next + projectSlides.length) % projectSlides.length;

    projectSlides.forEach((slide, i) => {
      const active = i === projectIndex;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', active ? 'false' : 'true');
    });

    projectDots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === projectIndex);
    });
  };

  const stopProjectAutoPlay = () => {
    if (projectTimer !== undefined) window.clearInterval(projectTimer);
    projectTimer = undefined;
  };

  const startProjectAutoPlay = () => {
    stopProjectAutoPlay();
    if (projectSlides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    projectTimer = window.setInterval(() => setProject(projectIndex + 1), 6500);
  };

  document.querySelector<HTMLButtonElement>('[data-project-prev]')?.addEventListener('click', () => {
    setProject(projectIndex - 1);
    startProjectAutoPlay();
  });

  document.querySelector<HTMLButtonElement>('[data-project-next]')?.addEventListener('click', () => {
    setProject(projectIndex + 1);
    startProjectAutoPlay();
  });

  projectDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      setProject(i);
      startProjectAutoPlay();
    });
  });

  projectSlider?.addEventListener('mouseenter', stopProjectAutoPlay);
  projectSlider?.addEventListener('mouseleave', startProjectAutoPlay);
  projectSlider?.addEventListener('focusin', stopProjectAutoPlay);
  projectSlider?.addEventListener('focusout', (event) => {
    if (!projectSlider.contains(event.relatedTarget as Node | null)) startProjectAutoPlay();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopProjectAutoPlay();
    else startProjectAutoPlay();
  });
  startProjectAutoPlay();
</script>

