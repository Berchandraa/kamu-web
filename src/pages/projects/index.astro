---
/**
 * Projects — portfolio index (Yodezeen model).
 * An "All Projects" header over a tight, image-led masonry grid:
 * varied heights, small consistent gaps, every slot a real interior.
 * A calm tracked-out filter bar scopes the grid by project type.
 * Captions stay minimal — name + location, clean separator system.
 */
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import CTA from '../../components/CTA.astro';

// Filter bar — built from the real project types in the data
const filters = [
  { key: 'all', label: 'All' },
  { key: 'residential', label: 'Residential' },
  { key: 'hospitality', label: 'Hospitality' },
];

---

<Base
  title="Projects"
  description="Selected interiors by KAMU Concepts — hospitality, residential and workspace projects across Bali."
>
  <!-- ============ HEADER ============ -->
  <header class="pj-head">
    <p class="label pj-eyebrow" data-reveal>
      <span class="duo"><span>Interior Design</span><span class="duo-sub">Architecture</span></span>
    </p>
    <h1 class="pj-title" data-reveal="line">All Projects</h1>
    <p class="pj-intro" data-reveal data-reveal-delay="0.1">
      From private homes to hospitality destinations, every project begins
      with understanding how a space should feel, not just how it should look.
    </p>

    <!-- ============ FILTER BAR ============ -->
    <div class="pj-filters" role="tablist" aria-label="Filter projects by type" data-reveal data-reveal-delay="0.15">
      {
        filters.map((f, i) => (
          <button
            class={`filter${i === 0 ? ' is-active' : ''}`}
            data-filter={f.key}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))
      }
    </div>
  </header>

  <!-- ============ MASONRY GRID ============ -->
  <section class="pj-projects" aria-label="Project collection">
    <div class="pj-grid" id="pj-grid">
      {
        projects.map((p) => (
          <a
            href={`/projects/${p.slug}/`}
            class="pj-card"
            data-type={p.type.toLowerCase()}
            data-reveal="media"
          >
            <div class="media pj-media">
              <img src={p.demo} alt={p.name} loading="lazy" />
              <div class="pj-hover-content">
                <h2 class="pj-name">{p.name}</h2>
                <p class="caption pj-loc duo">
                  <span>{p.location}</span><span class="duo-sub">{p.type}</span>
                </p>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <p class="pj-empty caption" id="pj-empty" hidden>No projects in this category yet.</p>
  </section>

  <CTA />
</Base>

<style>
  /* ================= HEADER ================= */
  .pj-head {
    padding-inline: var(--gutter);
    padding-top: calc(var(--nav-h) + var(--space-2xl));
    padding-bottom: var(--space-l);
  }

  .pj-eyebrow {
    color: var(--ink);
    margin-bottom: var(--space-s);
  }

  .pj-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    text-transform: uppercase;
  }

  .pj-intro {
    max-width: 32rem;
    margin-top: var(--space-m);
    color: var(--ink-soft);
  }

  /* ================= FILTER BAR ================= */
  .pj-filters {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-top: var(--space-l);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  /* ================= PROJECT GRID ================= */
  .pj-projects {
    height: 100svh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-l);
  }

  .pj-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(50, minmax(0, 1fr));
    height: calc(100svh - (2 * var(--space-l)));
    grid-auto-flow: dense;
    column-gap: clamp(0.6rem, 1vw, 1rem);
    row-gap: 0;
    padding-inline: var(--gutter);
    margin-top: 0;
  }

  .pj-card {
    display: block;
  }

  /* Yucca Villa and Lavi & Savi share the same visual height. */
  .pj-card:nth-child(4n + 1),
  .pj-card:nth-child(4n + 3) {
    grid-row: span 43;
  }

  .pj-card:nth-child(4n + 2) {
    grid-row: span 34;
  }

  .pj-card:nth-child(4n) {
    grid-row: span 38;
  }

  .pj-card.is-hidden {
    display: none;
  }

  .pj-media {
    position: relative;
    height: 100%;
    background: var(--bg-alt);
    overflow: hidden;
    border-radius: 0;
    transition: border-radius 0.45s var(--ease-out);
  }

  .pj-media img {
    object-fit: cover;
    object-position: center;
    transition: opacity 0.45s var(--ease-out);
  }

  .pj-card:hover .pj-media,
  .pj-card:focus-visible .pj-media {
    border-radius: 999px 999px 0 0;
    transition-duration: 4s;
  }

  .pj-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 0.65);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ease-out);
  }

  .pj-card:hover .pj-media::after,
  .pj-card:focus-visible .pj-media::after {
    opacity: 1;
    transition-duration: 4s;
  }

  /* ----- hover content ----- */
  .pj-hover-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
    padding: var(--space-m);
    padding-bottom: var(--space-l);
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out);
    pointer-events: none;
    background: linear-gradient(180deg, transparent 52%, rgb(0 0 0 / 0.52));
  }

  .pj-card:hover .pj-hover-content,
  .pj-card:focus-visible .pj-hover-content {
    opacity: 1;
    transform: translateY(0);
    transition-duration: 4s;
  }

  .pj-name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1rem, 1.8vw, 1.5rem);
    letter-spacing: 0.02em;
    color: var(--c-bone);
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .pj-loc {
    color: color-mix(in srgb, var(--c-bone) 85%, transparent);
    max-width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .pj-empty {
    padding: var(--space-2xl) var(--gutter);
    text-align: center;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 64rem) {
    .pj-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pj-hover-content {
      padding: var(--space-s);
      padding-bottom: var(--space-m);
    }
  }

  @media (max-width: 40rem) {
    .pj-head {
      padding-top: calc(var(--nav-h) + 3rem);
      padding-bottom: 2.5rem;
    }

    .pj-title {
      font-size: clamp(2.75rem, 15vw, 4.5rem);
      overflow-wrap: anywhere;
    }

    .pj-intro {
      max-width: 100%;
      margin-top: 1.25rem;
    }

    .pj-filters {
      flex-wrap: nowrap;
      gap: 1.5rem;
      margin-top: 2rem;
      padding-bottom: 0.75rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .pj-filters::-webkit-scrollbar {
      display: none;
    }

    .pj-filter {
      flex: 0 0 auto;
    }

    .pj-projects {
      height: auto;
      min-height: 0;
      padding-block: 1rem 4rem;
    }

    .pj-grid {
      grid-template-columns: 1fr;
      height: auto;
      grid-template-rows: none;
      grid-auto-rows: auto;
      gap: 3rem;
      padding-inline: var(--gutter);
    }

    .pj-card:nth-child(n) {
      grid-row: auto;
      min-width: 0;
      padding-bottom: 6rem;
    }

    .pj-media {
      height: clamp(16rem, 58svh, 28rem);
      aspect-ratio: 4 / 3;
      width: 100%;
      overflow: visible;
    }

    .pj-media::after {
      opacity: 0;
    }

    .pj-hover-content {
      inset: auto 0 auto;
      top: 100%;
      min-height: 0;
      align-items: flex-start;
      text-align: left;
      gap: 0.35rem;
      padding: 1rem 0 0;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      color: var(--ink);
      background: transparent;
    }

    .pj-name {
      font-size: clamp(1.1rem, 5vw, 1.5rem);
      color: var(--ink);
      max-width: 100%;
      overflow-wrap: anywhere;
    }

    .pj-loc {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0.2rem;
      width: 100%;
      line-height: 1.3;
      white-space: normal;
      color: var(--ink-soft);
      overflow-wrap: anywhere;
    }

    .pj-loc > span {
      max-width: 100%;
    }
  }
</style>

<style is:global>
  /* Projects index has a bone background from the very top (no dark hero),
     so pin the navbar to high-contrast ink and bring the links + CTA to
     full strength — they must read clearly over bone, never faint. */
  .nav:not(.is-condensed) {
    color: var(--ink);
  }
</style>

<script>
  const grid = document.getElementById('pj-grid');
  const empty = document.getElementById('pj-empty');
  const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.pj-card'));

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter || 'all';

      filters.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });

      let shown = 0;
      cards.forEach((card) => {
        const match = key === 'all' || card.dataset.type === key;
        card.classList.toggle('is-hidden', !match);
        // ensure any not-yet-revealed cards are visible once filtered in
        if (match) {
          card.style.opacity = '1';
          shown++;
        }
      });

      if (empty) empty.toggleAttribute('hidden', shown !== 0);
    });
  });
</script>
