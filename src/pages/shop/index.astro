---
/**
 * Shop — product catalog.
 * Single-row category filter (Tables, Chairs, …).
 * Cards max 450 px × 450 px, transparent background.
 */
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { products } from '../../data/products';

const filterGroups = [
  { key: 'all', label: 'All', categories: [] },
  { key: 'tables', label: 'Tables', categories: ['dining-table', 'coffee-table', 'side-table'] },
  { key: 'chairs', label: 'Chairs', categories: ['dining-chair', 'bar-chair'] },
  { key: 'seating', label: 'Seating', categories: ['lounge-chair', 'bench'] },
  { key: 'storage', label: 'Storage', categories: ['console', 'wardrobe'] },
  { key: 'lighting-decor', label: 'Lighting & Decor', categories: ['pendant-lamp', 'artwork'] },
] as const;

const groupFor = (category: string) =>
  filterGroups.find((group) => group.categories.includes(category as never))?.key ?? 'all';

const countGroup = (key: string) =>
  key === 'all' ? products.length : products.filter((p) => groupFor(p.category) === key).length;

const labelFor = (category: string) =>
  filterGroups.find((group) => group.categories.includes(category as never))?.label ?? 'Collection';

---

<Base
  title="Shop"
  description="Furniture and lighting by KAMU Concepts — handcrafted pieces for slow living, made in Bali."
>
  <!-- ============ COLLECTION HEADER ============ -->
  <header class="sh-page-head">
    <p class="label sh-page-eyebrow" data-reveal>
      <span class="duo"><span>by KAMU</span><span class="duo-sub">The Collection</span></span>
    </p>
    <h1 class="sh-page-title" data-reveal="line">Shop</h1>
    <p class="sh-page-intro" data-reveal data-reveal-delay="0.15">
      Handcrafted furniture and lighting, made in Bali. Designed slowly, built to last.
    </p>
  </header>

  <!-- ============ FILTERS ============ -->
  <div class="sh-bar" data-reveal>
    <nav class="sh-filters" aria-label="Product categories">
      {
        filterGroups.map((group, i) => (
          <button class={`sh-filter${i === 0 ? ' is-active' : ''}`} data-cat={group.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {group.label}<span class="sh-filter-n">{countGroup(group.key)}</span>
          </button>
        ))
      }
    </nav>
    <p class="label sh-showing">
      <span class="duo"><span>Showing</span><span class="duo-num" id="sh-count">{products.length}</span></span>
    </p>
  </div>

  <!-- ============ GRID ============ -->
  <section class="sh-grid" id="sh-grid">
    {
      products.map((p, i) => (
        <a
          href={`/shop/${p.slug}/`}
          class="sh-card"
          aria-label={p.name}
          data-category={p.category}
          data-group={groupFor(p.category)}
          data-reveal
          data-reveal-delay={String((i % 4) * 0.08)}
        >
          <div class="sh-media">
            <Placeholder name={p.file} ratio="1x1" demo={p.demo} alt={p.name} />
          </div>
          <div class="sh-caption">
            <div class="sh-caption-main">
              <h2 class="sh-name">{p.name}</h2>
              <p class="label sh-cat">{labelFor(p.category)}</p>
            </div>
            <p class="sh-price">{p.price}</p>
          </div>
        </a>
      ))
    }
  </section>
</Base>

<style>
  /* ================= PAGE HEADER + FILTER BAR ================= */
  .sh-page-head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--space-s);
    row-gap: var(--space-m);
    padding-inline: var(--gutter);
    padding-top: calc(var(--nav-h) + var(--space-2xl));
    padding-bottom: var(--space-xl);
    background: var(--bg-alt);
  }

  .sh-page-eyebrow,
  .sh-page-title,
  .sh-page-intro {
    grid-column: 1 / 7;
  }

  .sh-page-title {
    grid-column: 1 / 12;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    text-transform: uppercase;
  }

  .sh-page-intro {
    color: var(--ink-soft);
  }

  .sh-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-inline: var(--gutter);
    padding-block: var(--space-s) var(--space-l);
  }

  .sh-filters {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .sh-filter {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .sh-filter-n {
    font-family: var(--font-serif);
    font-size: 0.85em;
    letter-spacing: 0;
    opacity: 0.55;
    margin-left: 0.5em;
  }

  .sh-filter:hover,
  .sh-filter.is-active {
    color: var(--ink);
  }

  .sh-filter.is-active {
    font-weight: 500;
  }

  .sh-showing {
    color: var(--ink);
    white-space: nowrap;
  }

  /* ================= GRID ================= */
  .sh-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--space-m);
    row-gap: var(--space-xl);
    padding-inline: var(--gutter);
  }

  .sh-card[hidden] {
    display: none;
  }

  .sh-media {
    position: relative;
    width: min(450px, 100%);
    max-width: 100%;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
  }

  .sh-card :global(.media) {
    aspect-ratio: 1 / 1;
    background: transparent;
    overflow: hidden;
  }

  .sh-card :global(.media img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    object-position: center;
    transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur-slow) var(--ease-out);
  }

  .sh-card {
    min-width: 0;
  }

  .sh-card:hover :global(img) {
    transform: none;
    opacity: 1;
  }

  .sh-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    border-top: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    margin-top: 1rem;
    padding-top: 0.875rem;
  }

  .sh-name {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .sh-card:hover .sh-name {
    color: var(--accent);
  }

  .sh-cat {
    margin-top: 0.5rem;
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  .sh-price {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    color: var(--ink-soft);
    white-space: nowrap;
  }

  @media (max-width: 80rem) {
    .sh-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 56rem) {
    .sh-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .sh-grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-l);
    }

    .sh-page-eyebrow,
    .sh-page-title,
    .sh-page-intro {
      grid-column: 1 / -1;
    }

    .sh-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-s);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Category-only filter
  const catBtns = document.querySelectorAll<HTMLButtonElement>('[data-cat]');
  const cards = document.querySelectorAll<HTMLElement>('.sh-card');
  const grid = document.getElementById('sh-grid');
  const count = document.getElementById('sh-count');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let activeCat = 'all';

  function applyFilter() {
    const shown: HTMLElement[] = [];
    cards.forEach((card) => {
      const show = activeCat === 'all' || card.dataset.group === activeCat;
      card.hidden = !show;
      if (show) shown.push(card);
    });
    if (count) count.textContent = String(shown.length);
    if (!reduced) {
      gsap.fromTo(
        shown,
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.8, stagger: 0.06, ease: 'power3.out', overwrite: true }
      );
    } else {
      shown.forEach((c) => ((c.style.opacity = '1'), (c.style.transform = 'none')));
    }
  }

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat ?? 'all';
      catBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      if (!reduced) {
        gsap.to(cards, {
          opacity: 0,
          duration: 0.3,
          ease: 'power2.in',
          overwrite: true,
          onComplete: applyFilter,
        });
      } else {
        applyFilter();
      }
    });
  });

  applyFilter();
</script>
